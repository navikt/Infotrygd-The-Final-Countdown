# Use public npm registry for @navikt packages
@navikt:registry=https://registry.npmjs.org/

# Override JSR scope to avoid CI auth requirements.
# pnpm 10 may auto-configure @jsr:registry=https://npm.jsr.io/
# This project does not use JSR packages, so we force public npm.
@jsr:registry=https://registry.npmjs.org/

# Enforce Node engine compatibility (fail install on mismatch)
engine-strict=true

# Security: do not execute lifecycle scripts during install
ignore-scripts=true
